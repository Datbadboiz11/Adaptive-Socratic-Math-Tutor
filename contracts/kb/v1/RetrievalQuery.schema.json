    },
    "purpose": {
      "enum": [
        "explanation",
        "hint",
        "example"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "top_k": {
      "default": 3,
      "maximum": 10,
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    }
  },
  "required": [
    "query",
    "concept_id",
    "target_skill_id",
    "purpose"
