{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "format": "uuid",
          "title": "Assessment Id",
          "type": "string"
        },
        "assessment_status": {
          "$ref": "#/$defs/AssessmentStatus"
        },
        "first_error_step": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Error Step"
        },
        "primary_skill_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Skill Id"
        },
        "error_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Family"
        },
        "misconception_candidate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Misconception Candidate"
        },
        "diagnosis_status": {
          "default": "unknown",
          "enum": [
            "suspected",
            "supported",
            "unknown"
          ],
          "title": "Diagnosis Status",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "valid_solution",
            "invalid_transformation",
            "wrong_final_answer",
            "valid_partial",
            "ambiguous_input",
            "unsupported_scope",
            "cannot_verify"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "verification_method": {
          "enum": [
            "symbolic_and_rule",
            "reference",
            "none"
          ],
          "title": "Verification Method",
          "type": "string"
        },
        "validator_version": {
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "assessment_id",
        "assessment_status",
        "reason_code",
        "verification_method",
        "validator_version"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "AssessmentStatus": {
      "enum": [
        "verified_correct",
        "verified_incorrect",
        "unverified",
        "needs_clarification"
      ],
      "title": "AssessmentStatus",
      "type": "string"
    },
    "StepCheck": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        },
        "status": {
          "enum": [
            "equivalent",
            "incorrect",
            "unverified",
            "not_assessed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "step",
        "status"
      ],
      "title": "StepCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "problem_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
      "title": "Problem Id",
      "type": "string"
    },
    "concept_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
      "title": "Concept Id",
      "type": "string"
    },
    "content_version": {
      "title": "Content Version",
      "type": "string"
    },
    "submission_kind": {
      "enum": [
        "final_answer",
        "steps"
      ],
      "title": "Submission Kind",
      "type": "string"
    },
    "assessment": {
      "$ref": "#/$defs/Assessment"
    },
    "step_checks": {
      "items": {
        "$ref": "#/$defs/StepCheck"
      },
      "title": "Step Checks",
      "type": "array"
    },
    "completed": {
      "title": "Completed",
      "type": "boolean"
    },
    "diagnostic_question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diagnostic Question"
    },
    "diagnostic_source": {
      "default": "none",
      "enum": [
        "authored_pattern",
        "none"
      ],
      "title": "Diagnostic Source",
      "type": "string"
    },
    "updates_student_model": {
      "const": false,
      "default": false,
      "title": "Updates Student Model",
      "type": "boolean"
    },
    "mode": {
      "const": "internal_authoring_preview",
      "default": "internal_authoring_preview",
      "title": "Mode",
      "type": "string"
    },
    "analysis_version": {
      "default": "pilot-analyzer-1.0.0",
      "title": "Analysis Version",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "problem_id",
    "concept_id",
    "content_version",
    "submission_kind",
    "assessment",
    "step_checks",
    "completed",
    "limitations"
  ],
  "title": "PilotAnalysis",
  "type": "object"
}
