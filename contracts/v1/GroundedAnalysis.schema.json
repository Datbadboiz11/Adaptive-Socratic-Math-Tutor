{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "format": "uuid",
          "title": "Assessment Id",
          "type": "string"
        },
        "assessment_status": {
          "$ref": "#/$defs/AssessmentStatus"
        },
        "first_error_step": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Error Step"
        },
        "primary_skill_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Skill Id"
        },
        "error_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Family"
        },
        "misconception_candidate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Misconception Candidate"
        },
        "diagnosis_status": {
          "default": "unknown",
          "enum": [
            "suspected",
            "supported",
            "unknown"
          ],
          "title": "Diagnosis Status",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "valid_solution",
            "invalid_transformation",
            "wrong_final_answer",
            "valid_partial",
            "ambiguous_input",
            "unsupported_scope",
            "cannot_verify"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "verification_method": {
          "enum": [
            "symbolic_and_rule",
            "reference",
            "none"
          ],
          "title": "Verification Method",
          "type": "string"
        },
        "validator_version": {
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "assessment_id",
        "assessment_status",
        "reason_code",
        "verification_method",
        "validator_version"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "AssessmentStatus": {
      "enum": [
        "verified_correct",
        "verified_incorrect",
        "unverified",
        "needs_clarification"
      ],
      "title": "AssessmentStatus",
      "type": "string"
    },
    "KnowledgeChunk": {
      "additionalProperties": false,
      "properties": {
        "content_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Content Id",
          "type": "string"
        },
        "concept_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Concept Id",
          "type": "string"
        },
        "skill_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "title": "Skill Ids",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "explanation",
            "hint"
          ],
          "title": "Kind",
          "type": "string"
        },
        "hint_level": {
          "maximum": 3,
          "minimum": 0,
          "title": "Hint Level",
          "type": "integer"
        },
        "disclosure": {
          "enum": [
            "conceptual",
            "strategy",
            "scaffold"
          ],
          "title": "Disclosure",
          "type": "string"
        },
        "grade_levels": {
          "items": {
            "type": "integer"
          },
          "title": "Grade Levels",
          "type": "array"
        },
        "difficulty": {
          "const": "general",
          "default": "general",
          "title": "Difficulty",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "curriculum_source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Curriculum Source Id",
          "type": "string"
        },
        "content_version": {
          "title": "Content Version",
          "type": "string"
        },
        "review_status": {
          "title": "Review Status",
          "type": "string"
        },
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "text_sha256": {
          "title": "Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "content_id",
        "concept_id",
        "skill_ids",
        "title",
        "text",
        "kind",
        "hint_level",
        "disclosure",
        "grade_levels",
        "source",
        "curriculum_source_id",
        "content_version",
        "review_status",
        "approved",
        "text_sha256"
      ],
      "title": "KnowledgeChunk",
      "type": "object"
    },
    "PilotAnalysis": {
      "additionalProperties": false,
      "properties": {
        "problem_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Problem Id",
          "type": "string"
        },
        "concept_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Concept Id",
          "type": "string"
        },
        "content_version": {
          "title": "Content Version",
          "type": "string"
        },
        "submission_kind": {
          "enum": [
            "final_answer",
            "steps"
          ],
          "title": "Submission Kind",
          "type": "string"
        },
        "assessment": {
          "$ref": "#/$defs/Assessment"
        },
        "step_checks": {
          "items": {
            "$ref": "#/$defs/StepCheck"
          },
          "title": "Step Checks",
          "type": "array"
        },
        "completed": {
          "title": "Completed",
          "type": "boolean"
        },
        "diagnostic_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diagnostic Question"
        },
        "diagnostic_source": {
          "default": "none",
          "enum": [
            "authored_pattern",
            "none"
          ],
          "title": "Diagnostic Source",
          "type": "string"
        },
        "updates_student_model": {
          "const": false,
          "default": false,
          "title": "Updates Student Model",
          "type": "boolean"
        },
        "mode": {
          "const": "internal_authoring_preview",
          "default": "internal_authoring_preview",
          "title": "Mode",
          "type": "string"
        },
        "analysis_version": {
          "default": "pilot-analyzer-1.0.0",
          "title": "Analysis Version",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "problem_id",
        "concept_id",
        "content_version",
        "submission_kind",
        "assessment",
        "step_checks",
        "completed",
        "limitations"
      ],
      "title": "PilotAnalysis",
      "type": "object"
    },
    "PrerequisitePath": {
      "additionalProperties": false,
      "properties": {
        "concept_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Concept Id",
          "type": "string"
        },
        "concept_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "title": "Concept Ids",
          "type": "array"
        },
        "edge_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "title": "Edge Ids",
          "type": "array"
        },
        "depth": {
          "maximum": 2,
          "minimum": 1,
          "title": "Depth",
          "type": "integer"
        },
        "review_status": {
          "enum": [
            "draft",
            "human_approved"
          ],
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "concept_id",
        "concept_ids",
        "edge_ids",
        "depth",
        "review_status"
      ],
      "title": "PrerequisitePath",
      "type": "object"
    },
    "RetrievalResult": {
      "additionalProperties": false,
      "properties": {
        "requested_method": {
          "enum": [
            "metadata",
            "lexical",
            "semantic"
          ],
          "title": "Requested Method",
          "type": "string"
        },
        "actual_method": {
          "enum": [
            "metadata",
            "lexical",
            "semantic",
            "none"
          ],
          "title": "Actual Method",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "corpus_sha256": {
          "title": "Corpus Sha256",
          "type": "string"
        },
        "candidate_count": {
          "title": "Candidate Count",
          "type": "integer"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/RetrievedChunk"
          },
          "title": "Hits",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "embedding_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model"
        },
        "embedding_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Revision"
        },
        "embedding_dimensions": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Dimensions"
        },
        "vector_store": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vector Store"
        },
        "collection_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection Id"
        },
        "query_encoding_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Encoding Ms"
        },
        "query_encoding_source": {
          "anyOf": [
            {
              "enum": [
                "kaggle_catalog",
                "http_service",
                "injected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Encoding Source"
        },
        "mode": {
          "enum": [
            "internal_authoring_preview",
            "approved_only"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "requested_method",
        "actual_method",
        "query",
        "corpus_sha256",
        "candidate_count",
        "hits",
        "reason",
        "mode"
      ],
      "title": "RetrievalResult",
      "type": "object"
    },
    "RetrievedChunk": {
      "additionalProperties": false,
      "properties": {
        "chunk": {
          "$ref": "#/$defs/KnowledgeChunk"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "required": [
        "chunk"
      ],
      "title": "RetrievedChunk",
      "type": "object"
    },
    "StepCheck": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        },
        "status": {
          "enum": [
            "equivalent",
            "incorrect",
            "unverified",
            "not_assessed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "step",
        "status"
      ],
      "title": "StepCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "$ref": "#/$defs/PilotAnalysis"
    },
    "graph_snapshot_id": {
      "title": "Graph Snapshot Id",
      "type": "string"
    },
    "graph_provider": {
      "enum": [
        "registry",
        "neo4j",
        "registry_fallback"
      ],
      "title": "Graph Provider",
      "type": "string"
    },
    "graph_fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Graph Fallback Reason"
    },
    "prerequisites": {
      "items": {
        "$ref": "#/$defs/PrerequisitePath"
      },
      "title": "Prerequisites",
      "type": "array"
    },
    "retrieval": {
      "$ref": "#/$defs/RetrievalResult"
    },
    "log": {
      "additionalProperties": true,
      "title": "Log",
      "type": "object"
    },
    "mode": {
      "const": "internal_authoring_preview",
      "default": "internal_authoring_preview",
      "title": "Mode",
      "type": "string"
    },
    "updates_student_model": {
      "const": false,
      "default": false,
      "title": "Updates Student Model",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "analysis",
    "graph_snapshot_id",
    "graph_provider",
    "prerequisites",
    "retrieval",
    "log",
    "limitations"
  ],
  "title": "GroundedAnalysis",
  "type": "object"
}
