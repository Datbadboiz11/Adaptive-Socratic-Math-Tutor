{
  "additionalProperties": false,
  "properties": {
    "query": {
      "maxLength": 600,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "concept_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
        "type": "string"
      },
      "maxItems": 40,
      "minItems": 1,
      "title": "Concept Ids",
      "type": "array"
    },
    "purpose": {
      "default": "hint",
      "enum": [
        "explanation",
        "hint"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "hint_level": {
      "default": 1,
      "maximum": 3,
      "minimum": 1,
      "title": "Hint Level",
      "type": "integer"
    },
    "top_k": {
      "default": 3,
      "maximum": 5,
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    },
    "method": {
      "default": "semantic",
      "enum": [
        "metadata",
        "lexical",
        "semantic"
      ],
      "title": "Method",
      "type": "string"
    }
  },
  "required": [
    "query",
    "concept_ids"
  ],
  "title": "RetrievalRequest",
  "type": "object"
}
