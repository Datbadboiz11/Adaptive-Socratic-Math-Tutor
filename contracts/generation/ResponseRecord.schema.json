{
  "$defs": {
    "Check": {
      "description": "Lỗi verifier tìm thấy ở một lần sinh, hoặc lý do lần sinh LLM không cho ra câu nào.",
      "enum": [
        "answer_leak",
        "answer_key_missing",
        "math_unverified",
        "unsourced_equation",
        "unsourced_expression",
        "unverified_affirmation",
        "hint_level_exceeded",
        "missing_question",
        "unknown_content",
        "missing_content",
        "too_many_questions",
        "too_long",
        "repeated_message",
        "llm_unavailable",
        "llm_invalid_output"
      ],
      "title": "Check",
      "type": "string"
    },
    "LLMUsage": {
      "additionalProperties": false,
      "description": "Chi phí một lần gọi LLM (plan §18: latency/cost). Dùng chung cho Agent đề xuất và LLM\nextraction; tạo bằng ``app.llm.client.usage_from_call`` / ``usage_from_failure``.\n\nGhi cả khi lần gọi lỗi (``error``): lượt đó vẫn tốn thời gian và có thể tốn token.\n``model_id`` là tên model provider trả về (thường kèm ngày snapshot), không phải tên cấu hình.\nSố token để null khi provider không trả ``usage`` (timeout, lỗi mạng): không biết, khác với 0.\n``cost_usd`` để null khi chưa biết số token hoặc model không có trong bảng giá ``price_version``.",
      "properties": {
        "model_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "price_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Version"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "model_id",
        "prompt_version",
        "latency_ms"
      ],
      "title": "LLMUsage",
      "type": "object"
    },
    "ResponseAttempt": {
      "additionalProperties": false,
      "description": "Một lần sinh. ``source``: ``llm``; ``template`` (template đầy đủ, có chèn nội dung và đề bài);\n``template_safe`` (template không chèn gì, câu dự phòng cuối cùng).",
      "properties": {
        "source": {
          "enum": [
            "llm",
            "template",
            "template_safe"
          ],
          "title": "Source",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "content_ids_used": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "maxItems": 5,
          "title": "Content Ids Used",
          "type": "array"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Violations",
          "type": "array"
        },
        "accepted": {
          "default": false,
          "title": "Accepted",
          "type": "boolean"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/LLMUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "llm_output": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Output"
        }
      },
      "required": [
        "source"
      ],
      "title": "ResponseAttempt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Một dòng trong response log của phiên: câu đã gửi, nguồn, và mọi lần sinh trước đó.",
  "properties": {
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    },
    "decision_id": {
      "format": "uuid",
      "title": "Decision Id",
      "type": "string"
    },
    "template_version": {
      "title": "Template Version",
      "type": "string"
    },
    "verifier_version": {
      "title": "Verifier Version",
      "type": "string"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "llm_skipped_reason": {
      "anyOf": [
        {
          "const": "answer_key_missing",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llm Skipped Reason"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/ResponseAttempt"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Attempts",
      "type": "array"
    },
    "final_source": {
      "enum": [
        "template",
        "template_fallback",
        "llm",
        "system"
      ],
      "title": "Final Source",
      "type": "string"
    },
    "message": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "turn_id",
    "decision_id",
    "template_version",
    "verifier_version",
    "attempts",
    "final_source",
    "message"
  ],
  "title": "ResponseRecord",
  "type": "object"
}
