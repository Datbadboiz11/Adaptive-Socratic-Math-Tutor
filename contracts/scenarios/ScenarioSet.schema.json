{
  "$defs": {
    "AssessmentView": {
      "additionalProperties": false,
      "description": "Phần Agent cần từ Assessment của Member 1. Không chứa đáp án hay lời giải mẫu.",
      "properties": {
        "assessment_id": {
          "format": "uuid",
          "title": "Assessment Id",
          "type": "string"
        },
        "assessment_status": {
          "enum": [
            "verified_correct",
            "verified_incorrect",
            "unverified",
            "needs_clarification"
          ],
          "title": "Assessment Status",
          "type": "string"
        },
        "first_error_step": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Error Step"
        },
        "primary_skill_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Skill Id"
        },
        "error_family": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Family"
        },
        "misconception_candidate": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Misconception Candidate"
        },
        "diagnosis_status": {
          "default": "unknown",
          "enum": [
            "suspected",
            "supported",
            "unknown"
          ],
          "title": "Diagnosis Status",
          "type": "string"
        },
        "final_answer_only": {
          "default": false,
          "title": "Final Answer Only",
          "type": "boolean"
        }
      },
      "required": [
        "assessment_id",
        "assessment_status"
      ],
      "title": "AssessmentView",
      "type": "object"
    },
    "BKTParameters": {
      "additionalProperties": false,
      "properties": {
        "parameter_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Parameter Version",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "prior": {
          "maximum": 1,
          "minimum": 0,
          "title": "Prior",
          "type": "number"
        },
        "learn": {
          "maximum": 1,
          "minimum": 0,
          "title": "Learn",
          "type": "number"
        },
        "guess": {
          "maximum": 1,
          "minimum": 0,
          "title": "Guess",
          "type": "number"
        },
        "slip": {
          "maximum": 1,
          "minimum": 0,
          "title": "Slip",
          "type": "number"
        },
        "forget": {
          "const": 0,
          "default": 0,
          "title": "Forget",
          "type": "integer"
        }
      },
      "required": [
        "parameter_version",
        "source",
        "prior",
        "learn",
        "guess",
        "slip"
      ],
      "title": "BKTParameters",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "tool_calls_remaining": {
          "default": 3,
          "maximum": 3,
          "minimum": 0,
          "title": "Tool Calls Remaining",
          "type": "integer"
        },
        "regenerations_remaining": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Regenerations Remaining",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "BuiltScenario": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Scenario Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "split_group_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Split Group Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_reference": {
          "title": "Source Reference",
          "type": "string"
        },
        "tags": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "labels": {
          "$ref": "#/$defs/StrategyLabels"
        },
        "state": {
          "$ref": "#/$defs/StudentState"
        },
        "context": {
          "$ref": "#/$defs/TurnContext"
        },
        "replay": {
          "items": {
            "$ref": "#/$defs/ReplayRecord"
          },
          "title": "Replay",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "title",
        "split_group_id",
        "source",
        "source_reference",
        "tags",
        "labels",
        "state",
        "context",
        "replay"
      ],
      "title": "BuiltScenario",
      "type": "object"
    },
    "CurrentTask": {
      "additionalProperties": false,
      "properties": {
        "problem_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Problem Id",
          "type": "string"
        },
        "problem_version": {
          "title": "Problem Version",
          "type": "string"
        },
        "opportunity_id": {
          "format": "uuid",
          "title": "Opportunity Id",
          "type": "string"
        },
        "concept_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Concept Id",
          "type": "string"
        },
        "target_skill_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Target Skill Id",
          "type": "string"
        },
        "template_family_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Template Family Id",
          "type": "string"
        },
        "relation": {
          "enum": [
            "initial",
            "near_practice",
            "cross_family",
            "repeat",
            "prerequisite"
          ],
          "title": "Relation",
          "type": "string"
        },
        "difficulty": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difficulty"
        }
      },
      "required": [
        "problem_id",
        "problem_version",
        "opportunity_id",
        "concept_id",
        "target_skill_id",
        "template_family_id",
        "relation"
      ],
      "title": "CurrentTask",
      "type": "object"
    },
    "DecisionIntent": {
      "description": "Mục đích cụ thể của action. Đây không phải bộ strategy thứ hai (PRD FR-10):\nmỗi intent chỉ thuộc đúng một action và cho generator biết cần viết loại câu nào.",
      "enum": [
        "resolve_input",
        "restate_task",
        "elicit_reasoning",
        "distinguish_hypothesis",
        "probe_prerequisite",
        "prompt_self_check",
        "locate_error",
        "recall_rule",
        "target_misconception",
        "decompose_step",
        "analogous_example",
        "explain_concept",
        "review_prerequisite",
        "independent_check",
        "continue_practice",
        "advance_difficulty",
        "advance_concept",
        "return_to_parent",
        "switch_problem",
        "student_request",
        "session_goal_met",
        "budget_exhausted",
        "stuck_limit",
        "content_exhausted",
        "system_fallback"
      ],
      "title": "DecisionIntent",
      "type": "string"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "description": "Cạnh PREREQUISITE_OF do KG trả về: concept nguồn cần học trước concept đích.\n\n``depth`` = 1 khi đích là concept đang học, = 2 khi đích là một prerequisite trực tiếp của\nnó (PRD FR08-AC2: tối đa 2 tầng). ``review_status`` cho biết cạnh đã được người duyệt chưa;\ncạnh nháp chỉ xuất hiện khi tool được bật chế độ dev một cách tường minh.",
      "properties": {
        "edge_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Edge Id",
          "type": "string"
        },
        "source_concept_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Source Concept Id",
          "type": "string"
        },
        "target_concept_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Target Concept Id",
          "type": "string"
        },
        "source_skill_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Skill Ids",
          "type": "array"
        },
        "relation": {
          "const": "PREREQUISITE_OF",
          "default": "PREREQUISITE_OF",
          "title": "Relation",
          "type": "string"
        },
        "depth": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Depth",
          "type": "integer"
        },
        "review_status": {
          "default": "draft",
          "enum": [
            "draft",
            "machine_checked",
            "human_approved"
          ],
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "source_concept_id",
        "target_concept_id",
        "source_skill_ids"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "description": "Có ID riêng để ``EvidenceRef(kind=\"hypothesis\")`` trỏ đúng một giả thuyết, kể cả khi\ncùng misconception xuất hiện ở hai skill.",
      "properties": {
        "hypothesis_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "misconception_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Misconception Id",
          "type": "string"
        },
        "skill_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Skill Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "suspected",
            "supported",
            "ruled_out"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "misconception_id",
        "skill_id",
        "status",
        "evidence_ids"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "NextConcept": {
      "additionalProperties": false,
      "description": "Concept có thể học tiếp: nhận concept đang học làm prerequisite (cạnh ``edge_id``).\n\n``other_prerequisite_skill_ids`` là skill của các prerequisite trực tiếp khác của concept\nđó, để người chọn biết học sinh còn cần gì trước khi chuyển.",
      "properties": {
        "concept_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Concept Id",
          "type": "string"
        },
        "skill_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Skill Ids",
          "type": "array"
        },
        "edge_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Edge Id",
          "type": "string"
        },
        "review_status": {
          "default": "draft",
          "enum": [
            "draft",
            "machine_checked",
            "human_approved"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "other_prerequisite_skill_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "title": "Other Prerequisite Skill Ids",
          "type": "array"
        }
      },
      "required": [
        "concept_id",
        "skill_ids",
        "edge_id"
      ],
      "title": "NextConcept",
      "type": "object"
    },
    "ObservationStatus": {
      "additionalProperties": false,
      "properties": {
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "reason": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Reason",
          "type": "string"
        },
        "observation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Id"
        }
      },
      "required": [
        "eligible",
        "reason"
      ],
      "title": "ObservationStatus",
      "type": "object"
    },
    "PedagogicalAction": {
      "enum": [
        "clarify",
        "diagnose",
        "minimal_hint",
        "conceptual_question",
        "backtrack",
        "scaffold",
        "check_transfer",
        "next_problem",
        "end_session"
      ],
      "title": "PedagogicalAction",
      "type": "string"
    },
    "PrerequisiteProbe": {
      "additionalProperties": false,
      "description": "Một câu hỏi kiểm tra prerequisite đã hỏi trên bài hiện tại, gắn với lượt trả lời và kết\nquả xác minh câu trả lời đó (PRD FR08-AC3).\n\n- ``pending``: chưa có lượt trả lời (xin gợi ý, tạm dừng không tính là trả lời).\n- ``unverified``: có lượt sau đó nhưng không xác minh được, hoặc học sinh nộp bài thay vì trả lời.\n- ``demonstrated`` / ``not_demonstrated``: câu trả lời đã được xác minh.\nChỉ ``not_demonstrated`` là bằng chứng học sinh thiếu skill nền; việc đã hỏi thì không.",
      "properties": {
        "decision_id": {
          "format": "uuid",
          "title": "Decision Id",
          "type": "string"
        },
        "skill_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Skill Id",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "unverified",
            "demonstrated",
            "not_demonstrated"
          ],
          "title": "Status",
          "type": "string"
        },
        "answer_turn_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Turn Id"
        }
      },
      "required": [
        "decision_id",
        "skill_id"
      ],
      "title": "PrerequisiteProbe",
      "type": "object"
    },
    "ProblemRef": {
      "additionalProperties": false,
      "description": "Bài ứng viên lấy từ problem bank. Không có đáp án.",
      "properties": {
        "problem_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Problem Id",
          "type": "string"
        },
        "problem_version": {
          "title": "Problem Version",
          "type": "string"
        },
        "concept_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Concept Id",
          "type": "string"
        },
        "target_skill_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Target Skill Id",
          "type": "string"
        },
        "template_family_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Template Family Id",
          "type": "string"
        },
        "difficulty": {
          "maximum": 5,
          "minimum": 1,
          "title": "Difficulty",
          "type": "integer"
        }
      },
      "required": [
        "problem_id",
        "problem_version",
        "concept_id",
        "target_skill_id",
        "template_family_id",
        "difficulty"
      ],
      "title": "ProblemRef",
      "type": "object"
    },
    "ProblemSource": {
      "additionalProperties": false,
      "properties": {
        "problem": {
          "$ref": "#/$defs/ProblemRef"
        },
        "original_problem_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Original Problem Id",
          "type": "string"
        },
        "prompt": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "problem",
        "original_problem_id",
        "prompt"
      ],
      "title": "ProblemSource",
      "type": "object"
    },
    "RaterLabel": {
      "additionalProperties": false,
      "description": "Nhãn một người gán độc lập, trước khi hòa giải (plan §12: lưu nhãn ban đầu).",
      "properties": {
        "rater": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Rater",
          "type": "string"
        },
        "acceptable_actions": {
          "items": {
            "$ref": "#/$defs/PedagogicalAction"
          },
          "minItems": 1,
          "title": "Acceptable Actions",
          "type": "array"
        },
        "forbidden_actions": {
          "items": {
            "$ref": "#/$defs/PedagogicalAction"
          },
          "title": "Forbidden Actions",
          "type": "array"
        },
        "acceptable_intents": {
          "items": {
            "$ref": "#/$defs/DecisionIntent"
          },
          "title": "Acceptable Intents",
          "type": "array"
        },
        "acceptable_target_skill_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "title": "Acceptable Target Skill Ids",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "rater",
        "acceptable_actions",
        "rationale"
      ],
      "title": "RaterLabel",
      "type": "object"
    },
    "Readiness": {
      "additionalProperties": false,
      "description": "Tính bằng node xác định (không phải Agent) theo điều kiện dừng plan §10.",
      "properties": {
        "ready_to_advance": {
          "title": "Ready To Advance",
          "type": "boolean"
        },
        "criteria_version": {
          "title": "Criteria Version",
          "type": "string"
        },
        "unmet": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "title": "Unmet",
          "type": "array"
        }
      },
      "required": [
        "ready_to_advance",
        "criteria_version"
      ],
      "title": "Readiness",
      "type": "object"
    },
    "ReplayRecord": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "skill_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Skill Id",
          "type": "string"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "reason": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Reason",
          "type": "string"
        },
        "prediction_before": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prediction Before"
        },
        "mastery_before": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mastery Before",
          "type": "number"
        },
        "mastery_after": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mastery After",
          "type": "number"
        }
      },
      "required": [
        "turn_id",
        "skill_id",
        "eligible",
        "reason",
        "mastery_before",
        "mastery_after"
      ],
      "title": "ReplayRecord",
      "type": "object"
    },
    "RetrievedContent": {
      "additionalProperties": false,
      "description": "Một mục nội dung đã duyệt được đưa vào context.\n\n``disclosure_level`` là mức hint thấp nhất được phép hiển thị nội dung này: nội dung có\nmức tiết lộ 4 chỉ dùng được trong phản hồi mức 4. Không bao giờ chứa lời giải bài đang làm.",
      "properties": {
        "content_id": {
