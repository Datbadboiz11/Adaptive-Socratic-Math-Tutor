    "SkillState": {
      "additionalProperties": false,
      "description": "``p_mastery`` để trống trong cấu hình No-BKT/Heuristic hoặc khi chưa có tham số.\n``recent_independent`` là kết quả của tối đa 5 observation độc lập gần nhất, cũ trước mới sau\n(dùng cho cấu hình Heuristic, plan §18.1).",
      "properties": {
        "skill_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Skill Id",
          "type": "string"
        },
        "p_mastery": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Mastery"
        },
        "independent_observations": {
          "minimum": 0,
          "title": "Independent Observations",
          "type": "integer"
        },
        "recent_independent": {
          "items": {
            "type": "boolean"
          },
          "maxItems": 5,
          "title": "Recent Independent",
          "type": "array"
        },
        "assisted_correct": {
          "default": 0,
          "minimum": 0,
          "title": "Assisted Correct",
          "type": "integer"
        },
        "parameter_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Version"
        }
      },
      "required": [
        "skill_id",
        "independent_observations"
      ],
      "title": "SkillState",
      "type": "object"
    },
    "StrategyLabels": {
      "additionalProperties": false,
      "description": "Nhãn chiến lược cuối của một tình huống.\n\n``acceptable_intents`` và ``acceptable_target_skill_ids`` dành cho ca mà action chưa đủ phân biệt\n(ví dụ ``next_problem`` vừa là luyện tiếp vừa là chuyển concept). Để trống là không ràng buộc.\nAction nào có ít nhất một intent được liệt kê thì chỉ các intent đó được chấp nhận; action không\ncó intent nào được liệt kê thì nhận mọi intent của nó.\n\n``independent_labels`` giữ nhãn ban đầu của từng người; các trường ở trên là nhãn cuối sau hòa\ngiải. ``adjudicated`` cần ít nhất hai người gán nhãn độc lập (plan §12, bắt buộc với test).",
      "properties": {
        "acceptable_actions": {
          "items": {
            "$ref": "#/$defs/PedagogicalAction"
          },
          "minItems": 1,
          "title": "Acceptable Actions",
          "type": "array"
        },
        "forbidden_actions": {
          "items": {
            "$ref": "#/$defs/PedagogicalAction"
          },
          "title": "Forbidden Actions",
          "type": "array"
        },
        "acceptable_intents": {
          "items": {
            "$ref": "#/$defs/DecisionIntent"
          },
          "title": "Acceptable Intents",
          "type": "array"
        },
        "acceptable_target_skill_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "title": "Acceptable Target Skill Ids",
          "type": "array"
        },
        "review_status": {
          "default": "draft",
          "enum": [
            "draft",
            "human_approved",
            "adjudicated"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "author": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Author",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "independent_labels": {
          "items": {
            "$ref": "#/$defs/RaterLabel"
          },
          "title": "Independent Labels",
          "type": "array"
        },
        "adjudication_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Note"
        }
      },
      "required": [
        "acceptable_actions",
        "author",
        "rationale"
      ],
      "title": "StrategyLabels",
      "type": "object"
    },
    "StudentState": {
