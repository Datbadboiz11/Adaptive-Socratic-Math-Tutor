        "retrieved": [
          {
            "content_id": "KB-A02-QUESTION-01",
            "skill_id": "SK-A02-DISTRIBUTE",
            "content_type": "question",
            "disclosure_level": 0,
            "text": "Nếu viết k(a - b) thành (a - b) + (a - b) + ... (k lần), em thấy số b xuất hiện mấy lần?"
          },
          {
            "content_id": "KB-A02-HINT-01",
            "skill_id": "SK-A02-DISTRIBUTE",
            "content_type": "hint",
            "disclosure_level": 1,
            "text": "Khi nhân một số với một tổng hoặc hiệu trong ngoặc, em cần nhân số đó với từng số hạng trong ngoặc."
          },
          {
            "content_id": "KB-A02-EXAMPLE-01",
            "skill_id": "SK-A02-DISTRIBUTE",
            "content_type": "example",
            "disclosure_level": 3,
            "text": "Ví dụ: 3(a + 2) = 3·a + 3·2 = 3a + 6. Số 3 được nhân với cả a và 2."
          },
          {
            "content_id": "KB-A02-EXPLAIN-01",
            "skill_id": "SK-A02-DISTRIBUTE",
            "content_type": "explanation",
            "disclosure_level": 4,
            "text": "Tính chất phân phối: k(a + b) = ka + kb và k(a - b) = ka - kb. Ví dụ 5(y - 1) = 5y - 5: cả hai số hạng trong ngoặc đều được nhân với 5."
          }
        ],
