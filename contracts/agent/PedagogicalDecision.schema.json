{
  "$defs": {
    "DecisionConfig": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/ExperimentConfiguration"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "kb_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kb Version"
        },
        "graph_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Version"
        }
      },
      "required": [
        "configuration",
        "policy_version"
      ],
      "title": "DecisionConfig",
      "type": "object"
    },
    "DecisionIntent": {
      "description": "Mục đích cụ thể của action. Đây không phải bộ strategy thứ hai (PRD FR-10):\nmỗi intent chỉ thuộc đúng một action và cho generator biết cần viết loại câu nào.",
      "enum": [
        "resolve_input",
        "restate_task",
        "elicit_reasoning",
        "distinguish_hypothesis",
        "probe_prerequisite",
        "prompt_self_check",
        "locate_error",
        "recall_rule",
        "target_misconception",
        "decompose_step",
        "analogous_example",
        "explain_concept",
        "review_prerequisite",
        "independent_check",
        "continue_practice",
        "advance_difficulty",
        "advance_concept",
        "return_to_parent",
        "switch_problem",
        "student_request",
        "session_goal_met",
        "budget_exhausted",
        "stuck_limit",
        "content_exhausted",
        "system_fallback"
      ],
      "title": "DecisionIntent",
      "type": "string"
    },
    "DecisionProposal": {
      "additionalProperties": false,
      "description": "Đầu ra của Agent (hoặc Rule-policy) trước policy gate.\n\nKhông có trường nào ghi mastery hay tham số BKT (PRD FR10-AC5); ``extra=\"forbid\"`` chặn\nmọi trường lạ. ``reason`` là lý do ngắn kiểm tra được, không phải chuỗi suy nghĩ.",
      "properties": {
        "action": {
          "$ref": "#/$defs/PedagogicalAction"
        },
        "intent": {
          "$ref": "#/$defs/DecisionIntent"
        },
        "target_skill_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Skill Id"
        },
        "hint_level": {
          "default": 0,
          "maximum": 4,
          "minimum": 0,
          "title": "Hint Level",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 10,
          "title": "Evidence",
          "type": "array"
        },
        "content_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "maxItems": 5,
          "title": "Content Ids",
          "type": "array"
        },
        "edge_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "maxItems": 4,
          "title": "Edge Ids",
          "type": "array"
        },
        "problem_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Problem Id"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "intent",
        "reason"
      ],
      "title": "DecisionProposal",
      "type": "object"
    },
    "DecisionSource": {
      "enum": [
        "agent",
        "rule_policy",
        "fallback"
      ],
      "title": "DecisionSource",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "assessment",
        "observation",
        "hypothesis",
        "student_message",
        "decision"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExperimentConfiguration": {
      "description": "Cấu hình trong plan §18.1 có sinh PedagogicalDecision. Socratic LLM baseline không có\nstudent model/policy nên không ghi decision theo hợp đồng này.",
      "enum": [
        "full",
        "no_bkt",
        "heuristic",
        "no_kg",
        "no_rag",
        "rule_policy"
      ],
      "title": "ExperimentConfiguration",
      "type": "string"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "violated_rules": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "title": "Violated Rules",
          "type": "array"
        },
        "gate_version": {
          "title": "Gate Version",
          "type": "string"
        }
      },
      "required": [
        "status",
        "gate_version"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "LLMUsage": {
      "additionalProperties": false,
      "description": "Chi phí một lần gọi LLM (plan §18: latency/cost). Dùng chung cho Agent đề xuất và LLM\nextraction; tạo bằng ``app.llm.client.usage_from_call`` / ``usage_from_failure``.\n\nGhi cả khi lần gọi lỗi (``error``): lượt đó vẫn tốn thời gian và có thể tốn token.\n``model_id`` là tên model provider trả về (thường kèm ngày snapshot), không phải tên cấu hình.\nSố token để null khi provider không trả ``usage`` (timeout, lỗi mạng): không biết, khác với 0.\n``cost_usd`` để null khi chưa biết số token hoặc model không có trong bảng giá ``price_version``.",
      "properties": {
        "model_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "price_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Version"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "model_id",
        "prompt_version",
        "latency_ms"
      ],
      "title": "LLMUsage",
      "type": "object"
    },
    "PedagogicalAction": {
      "enum": [
        "clarify",
        "diagnose",
        "minimal_hint",
        "conceptual_question",
        "backtrack",
        "scaffold",
        "check_transfer",
        "next_problem",
        "end_session"
      ],
      "title": "PedagogicalAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bản ghi một quyết định trong decision log: giữ cả đề xuất lẫn kết quả sau gate\n(PRD FR10-AC4, §6.4). Quyết định fallback cũng phải qua gate (``fallback_gate``).",
  "properties": {
    "contract_version": {
      "const": "agent-contract-0.1.0",
      "default": "agent-contract-0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "decision_id": {
      "format": "uuid",
      "title": "Decision Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    },
    "opportunity_id": {
      "format": "uuid",
      "title": "Opportunity Id",
      "type": "string"
    },
    "state_version": {
      "minimum": 1,
      "title": "State Version",
      "type": "integer"
    },
    "proposed_by": {
      "enum": [
        "agent",
        "rule_policy"
      ],
      "title": "Proposed By",
      "type": "string"
    },
    "proposed": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionProposal"
        },
        {
          "type": "null"
        }
      ]
    },
    "gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/GateResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "final": {
      "$ref": "#/$defs/DecisionProposal"
    },
    "final_source": {
      "$ref": "#/$defs/DecisionSource"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "enum": [
            "gate_rejected",
            "agent_timeout",
            "agent_schema_error",
            "agent_error",
            "budget_exhausted"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "fallback_gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/GateResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool_calls_used": {
      "maximum": 3,
      "minimum": 0,
      "title": "Tool Calls Used",
      "type": "integer"
    },
    "tool_errors": {
      "items": {
        "maxLength": 120,
        "type": "string"
      },
      "maxItems": 5,
      "title": "Tool Errors",
      "type": "array"
    },
    "candidate_edge_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
        "type": "string"
      },
      "maxItems": 24,
      "title": "Candidate Edge Ids",
      "type": "array"
    },
    "kg_source": {
      "anyOf": [
        {
          "enum": [
            "neo4j",
            "registry_file"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kg Source"
    },
    "graph_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Graph Version"
    },
    "regenerations_used": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Regenerations Used",
      "type": "integer"
    },
    "agent_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/LLMUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decision_latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Latency Ms"
    },
    "workflow_version": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Version"
    },
    "config": {
      "$ref": "#/$defs/DecisionConfig"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "session_id",
    "turn_id",
    "opportunity_id",
    "state_version",
    "proposed_by",
    "proposed",
    "gate",
    "final",
    "final_source",
    "tool_calls_used",
    "config",
    "created_at"
  ],
  "title": "PedagogicalDecision",
  "type": "object"
}
