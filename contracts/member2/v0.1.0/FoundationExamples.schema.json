        "grade_levels": {
          "items": {
            "maximum": 12,
            "minimum": 6,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Grade Levels",
          "type": "array"
        },
        "difficulty": {
          "enum": [
            "introductory",
            "standard"
          ],
          "title": "Difficulty",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "opportunity_id",
        "allowed_concept_ids",
        "allowed_skill_ids",
        "allowed_hint_level",
        "kb_snapshot_version",
        "active_problem_id",
        "excluded_source_groups",
        "grade_levels",
        "difficulty"
      ],
      "title": "ServerRetrievalScope",
      "type": "object"
    },
