          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "locator": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "title",
        "locator"
      ],
      "title": "ContentSource",
      "type": "object"
    },
    "CurriculumProblemPublic": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "member2-proposal-0.1.0",
          "default": "member2-proposal-0.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "problem_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Problem Id",
          "type": "string"
        },
        "content_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Content Version",
          "type": "string"
        },
        "concept_id": {
          "pattern": "^[NAEF](0[1-9]|10)$",
          "title": "Concept Id",
          "type": "string"
        },
        "primary_skill_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Primary Skill Id",
          "type": "string"
        },
        "family_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Family Id",
          "type": "string"
        },
        "prompt": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/PublicTask"
        },
        "domain": {
          "const": "real_numbers",
          "default": "real_numbers",
          "title": "Domain",
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "introductory",
            "standard"
          ],
          "title": "Difficulty",
          "type": "string"
        }
      },
      "required": [
        "problem_id",
        "content_version",
        "concept_id",
        "primary_skill_id",
        "family_id",
        "prompt",
        "task",
        "difficulty"
      ],
      "title": "CurriculumProblemPublic",
      "type": "object"
    },
    "LearningReportSnapshot": {
      "additionalProperties": false,
      "description": "Server-computed, end-of-session facts; no client/LLM tallying.",
      "properties": {
        "contract_version": {
          "const": "member2-proposal-0.1.0",
          "default": "member2-proposal-0.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "state_version": {
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        },
        "status": {
          "const": "completed",
          "title": "Status",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "independent_correct": {
          "minimum": 0,
          "title": "Independent Correct",
          "type": "integer"
        },
        "assisted_correct": {
          "minimum": 0,
          "title": "Assisted Correct",
          "type": "integer"
        },
        "unverified_submissions": {
          "minimum": 0,
          "title": "Unverified Submissions",
          "type": "integer"
        },
        "valid_observations": {
          "minimum": 0,
          "title": "Valid Observations",
          "type": "integer"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillReport"
          },
          "title": "Skills",
          "type": "array"
        },
        "limitations": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "state_version",
        "status",
        "completed_at",
        "independent_correct",
        "assisted_correct",
        "unverified_submissions",
        "valid_observations",
        "skills",
        "limitations"
      ],
      "title": "LearningReportSnapshot",
      "type": "object"
    },
    "PublicTask": {
      "additionalProperties": false,
      "description": "The kind selects the task; expression/value are public problem inputs.",
      "properties": {
        "kind": {
          "enum": [
            "numeric",
            "evaluate",
            "polynomial",
            "linear_equation",
            "quadratic_vertex"
          ],
          "title": "Kind",
          "type": "string"
        },
        "expression": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "variable_value": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variable Value"
        }
      },
      "required": [
        "kind",
        "expression"
      ],
      "title": "PublicTask",
      "type": "object"
    },
    "RetrievalExchange": {
      "additionalProperties": false,
      "description": "Cross-check a result against the server scope before it reaches a generator.",
      "properties": {
        "request": {
          "$ref": "#/$defs/RetrievalRequest"
        },
        "result": {
          "$ref": "#/$defs/RetrievalResult"
        }
      },
      "required": [
        "request",
        "result"
      ],
      "title": "RetrievalExchange",
      "type": "object"
    },
    "RetrievalQuery": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "concept_id": {
          "pattern": "^[NAEF](0[1-9]|10)$",
          "title": "Concept Id",
          "type": "string"
        },
        "target_skill_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
