        },
        "retrieval_config_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Retrieval Config Version",
          "type": "string"
        },
        "method": {
          "enum": [
            "direct",
            "metadata",
            "semantic"
          ],
          "title": "Method",
          "type": "string"
        },
        "embedding_version": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Version"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "number"
        },
        "chunks": {
          "items": {
            "$ref": "#/$defs/TeachingChunk"
