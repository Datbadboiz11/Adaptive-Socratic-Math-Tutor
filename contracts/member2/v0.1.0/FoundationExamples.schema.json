{
  "$defs": {
    "ConceptReadiness": {
      "additionalProperties": false,
      "description": "Evidence gates for canonical curriculum; client flags cannot activate a topic.",
      "properties": {
        "concept_id": {
          "pattern": "^[NAEF](0[1-9]|10)$",
          "title": "Concept Id",
          "type": "string"
        },
        "has_pack": {
          "title": "Has Pack",
          "type": "boolean"
        },
        "alignment_approved": {
          "title": "Alignment Approved",
          "type": "boolean"
        },
        "concept_approved": {
          "title": "Concept Approved",
          "type": "boolean"
        },
        "pack_approved": {
          "title": "Pack Approved",
          "type": "boolean"
        },
        "prerequisites_approved": {
          "title": "Prerequisites Approved",
          "type": "boolean"
        },
        "validator_integrated": {
          "title": "Validator Integrated",
          "type": "boolean"
        },
        "ui_policy_verified": {
          "title": "Ui Policy Verified",
          "type": "boolean"
        },
        "contract_review_complete": {
          "title": "Contract Review Complete",
          "type": "boolean"
        }
      },
      "required": [
        "concept_id",
        "has_pack",
        "alignment_approved",
        "concept_approved",
        "pack_approved",
        "prerequisites_approved",
        "validator_integrated",
        "ui_policy_verified",
        "contract_review_complete"
      ],
      "title": "ConceptReadiness",
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "content_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Content Id",
          "type": "string"
        },
        "content_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Content Version",
          "type": "string"
        }
      },
      "required": [
        "content_id",
        "content_version"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "ContentSource": {
      "additionalProperties": false,
