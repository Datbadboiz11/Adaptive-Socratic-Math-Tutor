          "type": "integer"
        }
      },
      "required": [
        "query",
        "concept_id",
        "target_skill_id",
        "purpose"
      ],
      "title": "RetrievalQuery",
      "type": "object"
    },
    "RetrievalRequest": {
      "additionalProperties": false,
