      "required": [
        "retrieval_id",
        "request_id",
        "kb_snapshot_version",
        "retrieval_config_version",
        "method",
        "elapsed_ms",
        "chunks"
      ],
      "title": "RetrievalResult",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
