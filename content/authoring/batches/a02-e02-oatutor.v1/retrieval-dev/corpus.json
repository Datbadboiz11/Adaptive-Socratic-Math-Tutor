      "concept_id": "A02",
      "skill_ids": [
        "SK-A02-DISTRIBUTE"
      ],
      "kind": "hint",
      "text": "Khi khai triển, nhân thừa số ngoài ngoặc với từng hạng tử. Khi đặt nhân tử chung, chia từng hạng tử cho cùng nhân tử đã chọn; giữ dấu của các thương.",
      "hint_level": 2,
