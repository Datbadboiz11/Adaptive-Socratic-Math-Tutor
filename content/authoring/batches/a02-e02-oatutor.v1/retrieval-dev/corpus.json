    {
      "content_id": "DEV-E02-M2-OAT01-explanation",
      "content_version": "0.1.0",
      "concept_id": "E02",
      "skill_ids": [
        "SK-E02-SOLVE"
      ],
      "kind": "explanation",
      "text": "Một phép biến đổi phương trình phải giữ nguyên tập nghiệm. Có thể cộng hoặc trừ cùng một biểu thức ở hai vế, nhân hoặc chia cả hai vế cho cùng một số khác không. Nếu có ngoặc, khai triển rồi thu gọn, hoặc chia trước khi phù hợp. Gom các hạng tử chứa ẩn về một vế, các hằng số về vế còn lại rồi tách ẩn. Thay nghiệm tìm được vào phương trình ban đầu để kiểm tra.",
      "hint_level": 0,
      "disclosure": "conceptual",
      "grade_levels": [
        8
      ],
      "source_group": null,
      "problem_id": null,
      "pack_sha256": "08971caaefa0626be89bfec10866915e00bb65d5784ae85b996aed268115dd82",
      "review_status": "draft",
      "runtime_eligible": false,
      "content_sha256": "baa7c7d55f0d507031375b986123218eec276e7bd343a966a469963239147913"
    },
    {
      "content_id": "DEV-E02-M2-OAT01-hint-1",
      "content_version": "0.1.0",
      "concept_id": "E02",
      "skill_ids": [
        "SK-E02-SOLVE"
      ],
      "kind": "hint",
      "text": "Hãy nhìn cấu trúc hai vế: có ngoặc không, và các hạng tử chứa ẩn đang ở vế nào? Mỗi phép biến đổi cần giữ cân bằng phương trình.",
      "hint_level": 1,
      "disclosure": "conceptual",
      "grade_levels": [
        8
      ],
      "source_group": null,
      "problem_id": null,
      "pack_sha256": "08971caaefa0626be89bfec10866915e00bb65d5784ae85b996aed268115dd82",
      "review_status": "draft",
