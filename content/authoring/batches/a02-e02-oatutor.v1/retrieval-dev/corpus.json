      ],
      "kind": "explanation",
      "text": "Tính phân phối cho biết một thừa số ngoài ngoặc phải nhân với từng hạng tử trong ngoặc. Giữ dấu của từng hạng tử khi viết các tích rồi mới thu gọn. Dùng theo chiều ngược lại: tìm một nhân tử có mặt trong mọi hạng tử, chia từng hạng tử cho nhân tử đó và đặt các thương vào ngoặc. Có thể khai triển lại để kiểm tra biểu thức vừa đặt nhân tử chung.",
      "hint_level": 0,
      "disclosure": "conceptual",
      "grade_levels": [
        7,
        8
      ],
      "source_group": null,
      "problem_id": null,
      "pack_sha256": "6b5724d5010b6269e855d5632d70cbe82bad54f69b33d4d33cc5f4755e5d68fd",
