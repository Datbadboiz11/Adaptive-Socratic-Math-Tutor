    {
      "content_id": "DEV-A02-M2-OAT02-hint-2",
      "content_version": "0.1.0",
      "concept_id": "A02",
      "skill_ids": [
        "SK-A02-DISTRIBUTE"
      ],
      "kind": "hint",
      "text": "Nhân thừa số ngoài ngoặc với từng hạng tử. Giữ dấu trừ như một phần của hạng tử và kiểm tra dấu khi có hệ số âm.",
      "hint_level": 2,
      "disclosure": "strategy",
      "grade_levels": [
        7,
