    {
      "content_id": "DEV-E02-M2-OAT02-explanation",
      "content_version": "0.1.0",
      "concept_id": "E02",
      "skill_ids": [
        "SK-E02-SOLVE"
      ],
      "kind": "explanation",
      "text": "Biến đổi tương đương phải giữ nguyên tập nghiệm. Cộng hoặc trừ cùng một biểu thức ở cả hai vế giữ cân bằng; nhân hoặc chia cả hai vế cho cùng một số khác không cũng giữ tập nghiệm. Phép nhân với 0 không có phép toán nghịch đảo, nên phép chia cho 0 không xác định; nhân cả hai vế với 0 còn có thể làm mất điều kiện ban đầu. Nếu có ngoặc, có thể khai triển rồi thu gọn, hoặc chia trước cho hệ số khác không khi phù hợp. Gom các hạng tử chứa ẩn về một vế, hằng số về vế kia rồi tách ẩn. Thay kết quả vào phương trình ban đầu để kiểm tra.",
      "hint_level": 0,
      "disclosure": "conceptual",
      "grade_levels": [
        8
      ],
      "source_group": null,
      "problem_id": null,
      "pack_sha256": "8fd67dcd6fa7fcf80702a227b357563e803b8c458b83cf2b1d30662bc360291e",
      "review_status": "draft",
      "runtime_eligible": false,
      "content_sha256": "0845cb5a9773448813136207305cdd396ecf79bd84b48e0c303f642a7e520096"
    },
    {
      "content_id": "DEV-E02-M2-OAT02-hint-1",
      "content_version": "0.1.0",
      "concept_id": "E02",
      "skill_ids": [
        "SK-E02-SOLVE"
      ],
      "kind": "hint",
      "text": "Hãy nhìn cấu trúc hai vế: có ngoặc không, và các hạng tử chứa ẩn đang ở vế nào? Mỗi phép biến đổi cần giữ cân bằng phương trình.",
      "hint_level": 1,
      "disclosure": "conceptual",
      "grade_levels": [
        8
      ],
      "source_group": null,
      "problem_id": null,
      "pack_sha256": "8fd67dcd6fa7fcf80702a227b357563e803b8c458b83cf2b1d30662bc360291e",
      "review_status": "draft",
