      "content_sha256": "6ddb4875c01119f959f98fd5037ec1f6bbbf1dc7419dd528914160495e9a28e9"
    },
    {
      "content_id": "DEV-A02-M2-OAT02-hint-3",
      "content_version": "0.1.0",
      "concept_id": "A02",
      "skill_ids": [
        "SK-A02-DISTRIBUTE"
      ],
      "kind": "hint",
      "text": "Viết mỗi tích trên một phần riêng trước khi tính. Đánh dấu dấu của từng thừa số, tính dấu của tích rồi mới ghép các hạng tử và thu gọn.",
