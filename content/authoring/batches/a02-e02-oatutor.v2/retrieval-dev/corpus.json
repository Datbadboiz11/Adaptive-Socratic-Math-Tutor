    },
    {
      "content_id": "DEV-E02-M2-OAT02-hint-2",
      "content_version": "0.1.0",
      "concept_id": "E02",
      "skill_ids": [
        "SK-E02-SOLVE"
      ],
      "kind": "hint",
      "text": "Nếu có ngoặc, xử lý ngoặc rồi thu gọn. Chọn phép cộng hoặc trừ cùng một biểu thức ở cả hai vế để gom hạng tử chứa ẩn và hằng số.",
      "hint_level": 2,
      "disclosure": "strategy",
      "grade_levels": [
        8
      ],
      "source_group": null,
      "problem_id": null,
      "pack_sha256": "8fd67dcd6fa7fcf80702a227b357563e803b8c458b83cf2b1d30662bc360291e",
