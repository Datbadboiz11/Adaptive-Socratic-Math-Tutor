      ],
      "kind": "explanation",
      "text": "Tính phân phối cho phép khai triển một thừa số nhân với tổng hoặc hiệu: thừa số ngoài ngoặc phải nhân với từng hạng tử trong ngoặc. Với phép trừ, giữ nguyên dấu của hạng tử bị trừ khi viết tích. Nếu thừa số ngoài ngoặc âm, kiểm tra quy tắc dấu ở từng phép nhân; âm nhân âm cho kết quả dương. Hãy viết riêng các tích rồi mới thu gọn để không bỏ sót hạng tử.",
      "hint_level": 0,
      "disclosure": "conceptual",
      "grade_levels": [
        7,
        8
      ],
      "source_group": null,
      "problem_id": null,
      "pack_sha256": "a138ad3546e0bc4d305c3195bd5f7b9f217b2af54b3472c4c2dbc3e1333d2cfc",
      "review_status": "draft",
      "runtime_eligible": false,
      "content_sha256": "279041e2c746a90bfc138026ba489612c434ed7d031ef117cda8933bbda4b167"
    },
    {
      "content_id": "DEV-A02-M2-OAT02-hint-1",
