      "concept_id": "A02",
      "skill_ids": [
        "SK-A02-DISTRIBUTE"
      ],
      "kind": "hint",
      "text": "Trong ngoặc có những hạng tử nào? Thừa số ngoài ngoặc cần tác động đến từng hạng tử ra sao?",
      "hint_level": 1,
      "disclosure": "conceptual",
      "grade_levels": [
        7,
