    {
      "content_id": "DEV-E02-M2-OAT02-hint-3",
      "content_version": "0.1.0",
      "concept_id": "E02",
      "skill_ids": [
        "SK-E02-SOLVE"
      ],
      "kind": "hint",
      "text": "Viết rõ phép toán giống nhau ở cả hai vế cho bước em đang làm. Khi còn hệ số nhân với ẩn, chia cả hai vế cho hệ số khác không; cuối cùng thay kết quả vào phương trình gốc để kiểm tra.",
