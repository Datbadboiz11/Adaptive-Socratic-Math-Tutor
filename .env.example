# Local development only. Copy this file to .env; never commit .env.
POSTGRES_DB=mo_tutor_dev
POSTGRES_USER=mo_dev
POSTGRES_PASSWORD=mo_local_dev_only
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Local profile selection + unreviewed content preview. Not production auth.
DEMO_MODE=true

# New sessions use the Phase 3 tutor. Existing storage-only sessions are preserved.
TUTOR_ENABLED=true
# Authenticated authoring preview only; no persistent pilot sessions/BKT updates.
PILOT_ANALYZER_ENABLED=false
# KG/RAG internal preview; start optional Compose profile knowledge for Neo4j.
PILOT_GROUNDING_ENABLED=false
KG_PROVIDER=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=mo_graph_dev_only
NEO4J_HTTP_URL=http://localhost:7474
# Heavy dependencies/model are optional. Pre-cache model before enabling runtime.
INSTALL_LOCAL_EMBEDDING=false
LOCAL_EMBEDDING_ENABLED=false
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL_CACHE=data/models
RETRIEVAL_INDEX_PATH=data/retrieval/bge-m3-v1/index.json
# Qwen pilot: compose.rag.yaml opts in; legacy BGE evaluator/index stay separate.
PILOT_RETRIEVAL_BACKEND=qwen_pgvector
QWEN_ARTIFACT_PATH=data/retrieval/qwen3-4b-v1
# Kaggle batch mode; unseen text falls back explicitly. Select http for a live model server.
QWEN_QUERY_PROVIDER=catalog
QWEN_QUERY_CATALOG_PATH=data/retrieval/qwen3-4b-runtime/catalog.json
# Server-only service, never a browser URL or a Kaggle notebook tunnel.
QWEN_SERVICE_URL=http://127.0.0.1:8011
QWEN_CONTAINER_SERVICE_URL=http://qwen-embedding:8011
QWEN_SERVICE_TOKEN=
QWEN_SERVICE_TIMEOUT_SECONDS=120
# Used by the separate model process only; no auto-download during requests.
QWEN_MODEL_ENABLED=false
QWEN_SERVICE_DEVICE=cpu
QWEN_MODEL_CACHE=data/models/qwen3-4b
VALIDATOR_TIMEOUT_SECONDS=3
# Server only. Enable paid model calls explicitly; fallback works without a key.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=false
LLM_MAX_CALLS_PER_SESSION=8
