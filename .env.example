# Local development only. Copy this file to .env; never commit .env.
POSTGRES_DB=mo_tutor_dev
POSTGRES_USER=mo_dev
POSTGRES_PASSWORD=mo_local_dev_only
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Local profile selection + unreviewed content preview. Not production auth.
DEMO_MODE=true

# New sessions use the Phase 3 tutor. Existing storage-only sessions are preserved.
TUTOR_ENABLED=true
VALIDATOR_TIMEOUT_SECONDS=3
# Server only. Enable external model calls explicitly; fallback works without a key.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# Choose a model available to your account; verify its Free Tier in AI Studio.
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_ENABLED=false
LLM_MAX_CALLS_PER_SESSION=8

# Offline authoring CLI: independent from tutor LLM_ENABLED; key stays server-side.
# Export these variables in the CLI process; the CLI does not auto-load .env.
AUTHORING_LLM_ENABLED=false

# Stage 3: CPU embeddings, no model API key. The student Agent integration is Stage 4.
# Install backend/requirements-rag.txt only when using semantic retrieval.
INSTALL_RAG=false
# Optional absolute path to the pinned model directory for local CLI/runtime:
# KB_MODEL_DIR=D:/models/kb/faf4aa4225822f3bc6376869cb1164e8e3feedd0
# Docker: prepare a flat deployment copy to avoid broken HF cache links across platforms.
# python scripts/kb/prepare_embedding_model.py --export-dir artifacts/kb-model
# KB_MODEL_HOST_DIR=./artifacts/kb-model
