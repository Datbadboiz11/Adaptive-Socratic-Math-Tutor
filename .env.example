# Local development only. Copy this file to .env; never commit .env.
POSTGRES_DB=mo_tutor_dev
POSTGRES_USER=mo_dev
POSTGRES_PASSWORD=mo_local_dev_only
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Local profile selection + unreviewed content preview. Not production auth.
DEMO_MODE=true

# New sessions use the Phase 3 tutor. Existing storage-only sessions are preserved.
TUTOR_ENABLED=true
VALIDATOR_TIMEOUT_SECONDS=3
# Server only. Enable paid model calls explicitly; fallback works without a key.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=false
LLM_MAX_CALLS_PER_SESSION=8
# Agent LLM (backend/app/agent/llm.py): one call per turn, no retry; on timeout the turn falls back to Rule-policy.
AGENT_LLM_TIMEOUT_SECONDS=8

# Knowledge Graph (optional). Start with: docker compose --profile kg up -d neo4j
# Without NEO4J_URI the tutor reads the graph from content/curriculum/registry.v1.json.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-dev-only
